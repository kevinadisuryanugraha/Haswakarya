# ═══════════════════════════════════════════════════════════════════════════
# Haswakarya Crewing Operating System (H-COS) — Environment Configuration
# Salin menjadi `.env` lalu isi nilainya. Berkas `.env` TIDAK boleh di-commit.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Haswakarya Crewing OS"
NODE_ENV="development"

# Metadata deploy (dibaca /api/health dan log JSON)
APP_VERSION="dev"
GIT_SHA=""

# Tingkat log: debug | info | warn | error (default info)
LOG_LEVEL="info"
OTEL_SERVICE_NAME="hcos"

# ─── Database (PostgreSQL 16) ──────────────────────────────────────────────
DATABASE_URL="postgresql://haswakarya_admin:ChangeMeSecurePassword123!@localhost:5432/haswakarya_db?schema=public"

# ─── Redis (rate limiter + antrean BullMQ) ─────────────────────────────────
# Kosongkan untuk mode pengembangan tanpa Redis: limiter jatuh ke memori dan
# evaluasi matriks dijalankan inline, bukan lewat antrean.
REDIS_URL="redis://:RedisSecurePass123!@localhost:6379"

# ─── Sesi & autentikasi ────────────────────────────────────────────────────
# WAJIB minimal 32 karakter. Aplikasi menolak start di produksi bila kurang.
JWT_SECRET="generate_a_super_secure_jwt_secret_minimum_64_characters_for_production"

# ─── Storage vault dokumen maritim ─────────────────────────────────────────
VAULT_STORAGE_PATH="./storage/vault"

# ─── Observability ─────────────────────────────────────────────────────────
# Bearer token untuk `GET /api/metrics` (scrape Prometheus). Bila kosong,
# rute tersebut mengembalikan 404 di produksi dan terbuka di non-produksi.
METRICS_TOKEN=""

# ─── Backup (dipakai scripts/backup.sh & npm run backup:verify) ────────────
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=14
# Umur maksimum arsip terbaru sebelum `backup:verify` menyatakan FAIL.
BACKUP_MAX_AGE_DAYS=2

# ═══════════════════════════════════════════════════════════════════════════
# DICADANGKAN — belum dipakai kode mana pun. Jangan aktifkan sebelum ada
# integrasi nyata; lihat docs/DELIVERY-READINESS-2026-11-20.md §4 (risiko #4)
# dan _bmad-output/deferred-work.md.
# ═══════════════════════════════════════════════════════════════════════════
# DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
# HUBLA_SIMKAPEL_API_KEY=""
# RIGHTSHIP_API_KEY=""
# ─── Login demo portal (opsional, JANGAN aktifkan di produksi) ─────────────
# Bila NEXT_PUBLIC_DEMO_LOGIN="true", halaman /portal/login menampilkan dan
# mengisi otomatis kredensial demo. Default mati.
NEXT_PUBLIC_DEMO_LOGIN="false"
NEXT_PUBLIC_DEMO_PASSWORD=""

# ─── Seeding awal (opsional) ───────────────────────────────────────────────
# Kata sandi akun seed. Bila kosong, `npm run db:seed` membuat sandi acak
# dan mencetaknya sekali di akhir proses.
SEED_ADMIN_PASSWORD=""
